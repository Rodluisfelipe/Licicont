# ═══════════════════════════════════════════════
# LICICONT — Variables de Entorno
# ═══════════════════════════════════════════════

# MongoDB
MONGODB_URI=mongodb://localhost:27017/licicont

# Server
PORT=5000
NODE_ENV=development

# Client URL (para links en emails)
CLIENT_URL=http://localhost:5173

# Gmail SMTP (usar App Password de Google)
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ═══════════════════════════════════════════════
# Cliente (Vite) — opcional
# ═══════════════════════════════════════════════

# Recolector externo de diagnósticos (Formspree, Google Apps Script, Zapier, n8n…).
# Sin esta variable no se envía nada a terceros: el diagnóstico llega solo por
# WhatsApp y queda guardado en el navegador del visitante.
# VITE_LEAD_WEBHOOK_URL=https://formspree.io/f/xxxxxxx
